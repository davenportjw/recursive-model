# ==============================================================================
# 🧠 Tiny Recursive Gemma - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' before running or deploying the application:
#   cp .env.example .env
# ==============================================================================

# Google Cloud Project ID
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
GOOGLE_CLOUD_REGION="us-central1"

# Port number (Cloud Run defaults to 8080)
PORT=8080

# Local development mode:
# When set to "true", authentication is bypassed for local development and testing,
# and the /login page enables the 1-click "Bypass Auth (Local Developer)" button.
LOCAL_DEV="true"

# Authorized Email Domains & Addresses (SmartRouter Auth Pattern)
# Comma-separated list of permitted domain suffixes (e.g., 'google.com,joonix.net')
# or specific email addresses (e.g., 'davenportjw@gmail.com').
ALLOWED_EMAIL_DOMAINS="google.com,joonix.net,davenportjw@gmail.com"

# Session HMAC signing secret (minimum 32 characters)
SESSION_SECRET="replace-with-a-secure-random-32-byte-hex-string"

# (Optional) Google OAuth 2.0 Web Client ID for Google Identity Services on /login
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""

# (Optional) Shared secret for programmatic REST API access (SmartRouter convention)
# Allows machine-to-machine requests via 'X-Shared-Secret: <token>' or 'Authorization: Bearer <token>'
BACKEND_SHARED_SECRET=""
