# ==============================================================================
# 🧠 Tiny Recursive Gemma - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' before running or deploying the application:
#   cp .env.example .env
# ==============================================================================

# Google Cloud Project ID
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"

# Port number (Cloud Run defaults to 8080)
PORT=8080

# Local development mode:
# When set to "true", authentication is bypassed for local development and testing.
# In production, set to "false" to enforce Basic Auth and API security.
LOCAL_DEV="true"

# Basic Authentication Credentials
# Used to protect the Web Dashboard and API routes.
BASIC_AUTH_USER="admin"
BASIC_AUTH_PASSWORD="changeme-in-production"

# (Optional) Shared secret for programmatic REST API access (SmartRouter convention)
# Allows clients to authenticate via 'X-Shared-Secret: <token>' or 'Authorization: Bearer <token>'
BACKEND_SHARED_SECRET=""

# Gemini API Key for Option B Playground and Gemini 3.8 Flash Rubric Judge
GEMINI_API_KEY="AIzaSy..."
